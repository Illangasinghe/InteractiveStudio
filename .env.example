# Optional local service settings. Set these in your shell before npm run dev.
PORT=4310
STUDIO_DATA_DIR=./data
# Optional absolute paths; otherwise these executables are detected on PATH.
# FFMPEG_PATH=C:/tools/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/tools/ffmpeg/bin/ffprobe.exe
# RHUBARB_PATH=C:/tools/rhubarb/rhubarb.exe
# Rendering automatically finds Chrome or Edge on Windows; optional override:
# REMOTION_BROWSER_EXECUTABLE=C:/Program Files/Google/Chrome/Application/chrome.exe
# Optional render browser override. Installed Chrome/Edge is detected on Windows;
# otherwise Remotion downloads its compatible browser on the first render.
# REMOTION_BROWSER_EXECUTABLE=C:/Program Files/Google/Chrome/Application/chrome.exe
