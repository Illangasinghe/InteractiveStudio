{
  "name": "interactive-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first studio for personalised songs, stories and visual learning.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently -k -n service,editor \"npm:dev:server\" \"npm:dev:app\"",
    "dev:app": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "tsx server/index.ts",
    "test": "tsx --test packages/core/*.test.ts server/*.test.ts workers/*.test.ts renderer/three/*.test.ts",
    "study:camera": "tsx renderer/three/render-study.ts --video",
    "import:song": "tsx scripts/import-song.ts",
    "import:stem": "tsx scripts/import-stem.ts",
    "lipsync": "tsx scripts/lipsync.ts",
    "doctor": "tsx scripts/doctor.ts",
    "render:diagnostic": "tsx scripts/render.ts --diagnostic --duration=2",
    "render": "tsx scripts/render.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "express": "5.3.0",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "overrides": { "zod": "$zod" },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.0",
    "concurrently": "10.0.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
